# secrets.env.example
# Copy this file to secrets.env in the same directory and fill in the values.
# secrets.env is gitignored and NEVER committed. Do NOT put real values here.
#
# Grouping (see plan Scope "Template rendering"):
#   REQUIRED - install.ps1 ABORTS if missing / empty / multiline:
#   OPTIONAL - used only by write-auth.ps1; missing -> warn, do not abort.

# --- REQUIRED (install.ps1 aborts if missing/empty) ---

# Context7 MCP API key (opencode.json.template -> mcp.context7.headers)
CONTEXT7_API_KEY=

# npm registry auth token (.npmrc.template -> registry authToken)
NPM_TOKEN=

# Directory of the oc-usage tool (command/oc-usage.md.template -> OC_USAGE_DIR)
OC_USAGE_DIR=

# Git user name (.gitconfig.template -> user.name)
GIT_NAME=

# Git user email (.gitconfig.template -> user.email)
GIT_EMAIL=

# Git editor (.gitconfig.template -> core.editor)
GIT_EDITOR=

# --- OPTIONAL (write-auth.ps1 only; missing -> warn, do not abort) ---

# Provider API key -> auth.json provider "openrouter"
OPENROUTER_API_KEY=

# Provider API key -> auth.json provider "nvidia"
NVIDIA_API_KEY=

# Provider API key -> auth.json provider "opencode"
OPENCODE_API_KEY=

# Provider API key -> auth.json provider "opencode-go"
OPENCODE_GO_KEY=
